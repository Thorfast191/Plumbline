generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  stores        Store[]
  orders        Order[]
  refunds       Refund[]
  transactions  Transaction[]
  customers     Customer[]
  cogsEntries   EnrichCogs[]
  adSpendEntries EnrichAdSpend[]
  shippingCostEntries EnrichShippingCost[]
  scheduledReports ScheduledReport[]
  alertRules       AlertRule[]
  deliveryLogs     DeliveryLog[]

  @@map("accounts")
}

model Store {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  shopDomain            String    @unique @map("shop_domain")
  shopCurrency          String    @map("shop_currency")
  shopTimezone          String    @map("shop_timezone")
  accessTokenEncrypted  String?   @map("access_token_encrypted")
  refreshTokenEncrypted String?   @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime? @map("token_expires_at")
  scopes                String?
  installedAt           DateTime? @map("installed_at")
  uninstalledAt         DateTime? @map("uninstalled_at")

  account       Account        @relation(fields: [accountId], references: [id])
  orders        Order[]
  refunds       Refund[]
  transactions  Transaction[]
  customers     Customer[]
  webhookEvents WebhookEvent[]
  syncStates    SyncState[]
  syncCorrections SyncCorrection[]
  cogsEntries   EnrichCogs[]
  adSpendEntries EnrichAdSpend[]
  shippingCostEntries EnrichShippingCost[]
  scheduledReports ScheduledReport[]
  alertRules       AlertRule[]
  deliveryLogs     DeliveryLog[]

  @@index([accountId])
  @@map("stores")
}

model Order {
  id                        String    @id @default(cuid())
  accountId                 String    @map("account_id")
  storeId                   String    @map("store_id")
  shopifyOrderId             String    @map("shopify_order_id")
  customerId                 String?   @map("customer_id")
  createdAt                 DateTime  @map("created_at")
  processedAt                DateTime  @map("processed_at")
  cancelledAt                DateTime? @map("cancelled_at")
  closedAt                   DateTime? @map("closed_at")
  test                       Boolean   @default(false)
  currencyCode                String    @map("currency_code")
  presentmentCurrencyCode      String    @map("presentment_currency_code")
  grossSalesMinor              Int       @map("gross_sales_minor")
  discountsMinor               Int       @map("discounts_minor")
  shippingMinor                 Int       @map("shipping_minor")
  taxesMinor                    Int       @map("taxes_minor")
  currentSubtotalMinor           Int       @map("current_subtotal_minor")
  currentTotalMinor              Int       @map("current_total_minor")
  displayFinancialStatus        String    @map("display_financial_status")
  displayFulfillmentStatus      String    @map("display_fulfillment_status")
  shopifyUpdatedAt            DateTime? @map("shopify_updated_at") // Shopify's own updated_at, for last-write-wins merges (docs/PLAN.md §10)
  syncedAt                    DateTime  @default(now()) @map("synced_at")
  source                     String
  // Shopify Order.sourceName (e.g. "web", "pos", "iphone") — raw platform
  // field, captured verbatim. See Shopify GraphQL Admin API Order object
  // docs (Order.sourceName), https://shopify.dev/docs/api/admin-graphql/latest/objects/Order
  // — read at Phase 5 time; not independently re-verified beyond the
  // existing PLAN.md Phase 1 pass, flagged here for anyone reconfirming.
  sourceName                 String?   @map("source_name")
  // Heuristic channel bucket ('meta' | 'google' | 'direct' | 'other' | null
  // for unknown) derived from Order.customerJourneySummary's UTM/referrer
  // fields at sync time. This is a best-effort attribution heuristic, NOT a
  // guaranteed-accurate one — multi-touch journeys collapse to a single
  // bucket, and Shopify's own attribution windows/rules are not fully
  // reproduced here. Every metric that reads this column documents the
  // heuristic explicitly rather than presenting it as fact. No live
  // Shopify data exists yet to populate this from a real sync; Phase 3's
  // upsert path is the place this gets set once credentials exist.
  referrerChannel             String?   @map("referrer_channel")

  account       Account   @relation(fields: [accountId], references: [id])
  store         Store     @relation(fields: [storeId], references: [id])
  customer      Customer? @relation("CustomerOrders", fields: [customerId], references: [id])
  lineItems     OrderLineItem[]
  refunds       Refund[]
  discountRows  Discount[]
  transactions  Transaction[]
  firstOrderOf  Customer[] @relation("CustomerFirstOrder")

  @@unique([storeId, shopifyOrderId])
  @@index([storeId, createdAt])
  @@index([storeId, processedAt])
  @@index([storeId, customerId])
  @@index([accountId])
  @@map("orders")
}

model OrderLineItem {
  id                 String @id @default(cuid())
  accountId          String @map("account_id")
  orderId            String @map("order_id")
  shopifyLineItemId  String @map("shopify_line_item_id")
  productId          String? @map("product_id")
  variantId          String? @map("variant_id")
  sku                String?
  quantity           Int
  priceMinor         Int    @map("price_minor")
  discountMinor      Int    @map("discount_minor")
  currencyCode       String @map("currency_code")

  order         Order          @relation(fields: [orderId], references: [id])
  refundLines   RefundLineItem[]

  @@unique([orderId, shopifyLineItemId])
  @@index([orderId])
  @@index([accountId])
  @@map("order_line_items")
}

model Refund {
  id                   String   @id @default(cuid())
  accountId            String   @map("account_id")
  storeId              String   @map("store_id")
  orderId              String   @map("order_id")
  shopifyRefundId      String   @map("shopify_refund_id")
  processedAt          DateTime @map("processed_at")
  amountMinor          Int      @map("amount_minor")
  shippingRefundMinor  Int      @map("shipping_refund_minor")
  taxRefundMinor       Int      @map("tax_refund_minor")
  currencyCode         String   @map("currency_code")

  account     Account @relation(fields: [accountId], references: [id])
  store       Store   @relation(fields: [storeId], references: [id])
  order       Order   @relation(fields: [orderId], references: [id])
  lineItems   RefundLineItem[]

  @@unique([storeId, shopifyRefundId])
  @@index([storeId, processedAt])
  @@index([accountId])
  @@map("refunds")
}

model RefundLineItem {
  id              String @id @default(cuid())
  accountId       String @map("account_id")
  refundId        String @map("refund_id")
  orderLineItemId String @map("order_line_item_id")
  quantity        Int
  amountMinor     Int    @map("amount_minor")

  refund       Refund        @relation(fields: [refundId], references: [id])
  orderLine    OrderLineItem @relation(fields: [orderLineItemId], references: [id])

  @@index([refundId])
  @@index([accountId])
  @@map("refund_line_items")
}

model Discount {
  id              String  @id @default(cuid())
  accountId       String  @map("account_id")
  orderId         String  @map("order_id")
  applicationType String  @map("application_type") // 'code' | 'automatic' | 'script'
  code            String?
  amountMinor     Int     @map("amount_minor")
  currencyCode    String  @map("currency_code")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([accountId])
  @@map("discounts")
}

model Transaction {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  storeId               String    @map("store_id")
  orderId               String    @map("order_id")
  shopifyTransactionId  String    @map("shopify_transaction_id")
  kind                  String // 'sale' | 'refund' | 'void' | 'capture'
  status                String
  amountMinor           Int       @map("amount_minor")
  feeMinor               Int?      @map("fee_minor")
  currencyCode          String    @map("currency_code")
  processedAt           DateTime  @map("processed_at")

  account Account @relation(fields: [accountId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])

  @@unique([storeId, shopifyTransactionId])
  @@index([accountId])
  @@map("transactions")
}

model Customer {
  id                 String   @id @default(cuid())
  accountId          String   @map("account_id")
  storeId            String   @map("store_id")
  shopifyCustomerId  String   @map("shopify_customer_id")
  createdAt          DateTime @map("created_at")
  firstOrderId       String?  @map("first_order_id")
  currencyCode       String   @map("currency_code")

  account   Account @relation(fields: [accountId], references: [id])
  store     Store   @relation(fields: [storeId], references: [id])
  firstOrder Order? @relation("CustomerFirstOrder", fields: [firstOrderId], references: [id])
  orders    Order[] @relation("CustomerOrders")

  @@unique([storeId, shopifyCustomerId])
  @@index([accountId])
  @@map("customers")
}

model WebhookEvent {
  id              String   @id @default(cuid())
  accountId       String   @map("account_id")
  storeId         String   @map("store_id")
  shopifyWebhookId String  @map("shopify_webhook_id")
  topic           String
  receivedAt      DateTime @default(now()) @map("received_at")
  payloadHash     String   @map("payload_hash")
  status          String // 'processed' | 'duplicate' | 'failed'

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, shopifyWebhookId])
  @@index([accountId])
  @@map("webhook_events")
}

model SyncState {
  id           String    @id @default(cuid())
  accountId    String    @map("account_id")
  storeId      String    @map("store_id")
  resource     String // 'orders' | 'products' | 'customers'
  kind         String // 'backfill' | 'incremental'
  cursor       String?
  watermarkAt  DateTime? @map("watermark_at")
  status       String
  updatedAt    DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, resource, kind])
  @@index([accountId])
  @@map("sync_state")
}

model EnrichCogs {
  id            String   @id @default(cuid())
  accountId     String   @map("account_id")
  storeId       String   @map("store_id")
  sku           String
  costMinor     Int      @map("cost_minor")
  currencyCode  String   @map("currency_code")
  effectiveFrom DateTime @map("effective_from")
  source        String // 'csv_upload'

  account Account @relation(fields: [accountId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])

  @@index([accountId])
  @@index([storeId, sku])
  @@map("enrich_cogs")
}

model SyncCorrection {
  id          String   @id @default(cuid())
  accountId   String   @map("account_id")
  storeId     String   @map("store_id")
  resource    String // 'orders' | 'refunds' | ...
  resourceId  String   @map("resource_id") // shopify natural id of the corrected record
  field       String
  oldValue    String?  @map("old_value")
  newValue    String?  @map("new_value")
  detectedAt  DateTime @default(now()) @map("detected_at")

  store Store @relation(fields: [storeId], references: [id])

  @@index([accountId])
  @@index([storeId, detectedAt])
  @@map("sync_corrections")
}

model EnrichAdSpend {
  id           String   @id @default(cuid())
  accountId    String   @map("account_id")
  storeId      String   @map("store_id")
  channel      String // 'meta' | 'google'
  date         DateTime
  spendMinor   Int      @map("spend_minor")
  currencyCode String   @map("currency_code")
  source       String // 'csv_upload' | 'api'

  account Account @relation(fields: [accountId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])

  @@index([accountId])
  @@index([storeId, channel, date])
  @@map("enrich_ad_spend")
}

// Third enrich input named in CLAUDE.md's architecture table
// ("packages/enrich  external inputs: COGS, ad spend, shipping cost") but
// not yet modeled — added here for Phase 5's contribution-margin metric.
// Modeled as a flat estimated cost-per-shipment (like EnrichCogs, versioned
// by effectiveFrom), not a per-order actual cost, because no per-order
// shipping cost source exists (Shopify's own order data has shipping
// *charged to the customer*, not the merchant's actual carrier cost) —
// this is explicitly an estimate, surfaced as such in the metric UI.
model EnrichShippingCost {
  id            String   @id @default(cuid())
  accountId     String   @map("account_id")
  storeId       String   @map("store_id")
  costMinor     Int      @map("cost_minor") // estimated average cost per shipment/order
  currencyCode  String   @map("currency_code")
  effectiveFrom DateTime @map("effective_from")
  source        String // 'csv_upload'

  account Account @relation(fields: [accountId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])

  @@index([accountId])
  @@index([storeId, effectiveFrom])
  @@map("enrich_shipping_cost")
}

// Phase 7 — docs/BUILD-SPEC.md: "Scheduled report delivery by email on a
// cadence the merchant sets." One row per (store, report type, cadence);
// `lastSentAt` drives due-date computation in packages/report (see
// packages/report/src/period.ts's isReportDue) — a schedule with no prior
// send is due immediately, matching the intuition that turning a schedule
// on should send the first report on the next evaluation pass rather than
// waiting a full cadence period.
model ScheduledReport {
  id              String    @id @default(cuid())
  accountId       String    @map("account_id")
  storeId         String    @map("store_id")
  reportType      String    @map("report_type") // 'sales_overview' | 'profitability'
  cadence         String // 'weekly' | 'monthly'
  recipientEmails String[]  @map("recipient_emails")
  active          Boolean   @default(true)
  lastSentAt      DateTime? @map("last_sent_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  account      Account       @relation(fields: [accountId], references: [id])
  store        Store         @relation(fields: [storeId], references: [id])
  deliveryLogs DeliveryLog[]

  @@index([accountId])
  @@index([storeId, active])
  @@map("scheduled_reports")
}

// Phase 7 — docs/BUILD-SPEC.md: "Threshold alerts: margin below X, returns
// above Y, a SKU's velocity dropping." Two rule kinds share one table
// rather than two, since both are "evaluate a figure against a threshold
// on a cadence and email if crossed" — the branch is in which columns are
// populated, not a different lifecycle. `metric_threshold` uses
// metricId/comparator/thresholdMinor (metricId must be a scalar,
// money-denominated metric from packages/metrics — contribution_margin for
// "margin below X", sales_reversals for "returns above Y").
// `sku_velocity_drop` uses sku/velocityDropPercent, comparing this
// cadence's period against the immediately preceding period of the same
// length for that SKU's units sold (packages/metrics' sku_units_sold
// table metric).
model AlertRule {
  id                  String    @id @default(cuid())
  accountId           String    @map("account_id")
  storeId             String    @map("store_id")
  kind                String // 'metric_threshold' | 'sku_velocity_drop'
  metricId            String?   @map("metric_id")
  comparator          String? // 'below' | 'above'
  thresholdMinor      Int?      @map("threshold_minor")
  sku                 String?
  velocityDropPercent Int?      @map("velocity_drop_percent")
  cadence             String // 'weekly' | 'monthly' — how often this rule is evaluated
  recipientEmails     String[]  @map("recipient_emails")
  active              Boolean   @default(true)
  lastEvaluatedAt     DateTime? @map("last_evaluated_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  account      Account       @relation(fields: [accountId], references: [id])
  store        Store         @relation(fields: [storeId], references: [id])
  deliveryLogs DeliveryLog[]

  @@index([accountId])
  @@index([storeId, active])
  @@map("alert_rules")
}

// Phase 7 — docs/BUILD-SPEC.md: "Delivery log with retry." One row per send
// attempt (not per logical delivery), so a failed attempt followed by a
// successful retry produces two rows, giving a real attempt-by-attempt
// audit trail rather than a single mutated status field.
model DeliveryLog {
  id                String   @id @default(cuid())
  accountId         String   @map("account_id")
  storeId           String   @map("store_id")
  kind              String // 'scheduled_report' | 'alert'
  scheduledReportId String?  @map("scheduled_report_id")
  alertRuleId       String?  @map("alert_rule_id")
  status            String // 'delivered' | 'failed'
  attempt           Int      @default(1)
  errorMessage      String?  @map("error_message")
  recipientEmails   String[] @map("recipient_emails")
  subject           String
  periodFrom        DateTime @map("period_from")
  periodTo          DateTime @map("period_to")
  createdAt         DateTime @default(now()) @map("created_at")

  account         Account          @relation(fields: [accountId], references: [id])
  store           Store            @relation(fields: [storeId], references: [id])
  scheduledReport ScheduledReport? @relation(fields: [scheduledReportId], references: [id])
  alertRule       AlertRule?       @relation(fields: [alertRuleId], references: [id])

  @@index([accountId])
  @@index([storeId, createdAt])
  @@map("delivery_log")
}
