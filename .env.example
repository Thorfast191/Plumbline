# Postgres — local dev/test databases.
# DATABASE_URL must be a NON-superuser role (Postgres RLS is bypassed entirely
# for superusers, so the app must never connect as one — see
# packages/model/prisma/migrations/*_add_account_id_and_rls/migration.sql).
DATABASE_URL="postgresql://plumbline_app:PASSWORD@localhost:5432/plumbline_dev"
DATABASE_URL_TEST="postgresql://plumbline_app:PASSWORD@localhost:5432/plumbline_test"

# Superuser/admin connection, used only for `prisma migrate` (DDL).
DATABASE_URL_MIGRATE="postgresql://postgres:PASSWORD@localhost:5432/plumbline_dev"
DATABASE_URL_MIGRATE_TEST="postgresql://postgres:PASSWORD@localhost:5432/plumbline_test"

# Shopify Partner app — create at https://partners.shopify.com
# Required before any live OAuth / API call will work.
# See packages/connector/src/errors.ts ShopifyCredentialsMissingError.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL="http://localhost:3000"
SHOPIFY_SCOPES="read_orders,read_all_orders,read_products,read_customers,read_discounts"
# API version to pin the connector to (never "unstable"/"latest" — see docs/PLAN.md §8)
SHOPIFY_API_VERSION="2026-01"
