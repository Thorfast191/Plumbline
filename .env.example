# Postgres — local dev/test databases.
# DATABASE_URL must be a NON-superuser role (Postgres RLS is bypassed entirely
# for superusers, so the app must never connect as one — see
# packages/model/prisma/migrations/*_add_account_id_and_rls/migration.sql).
DATABASE_URL="postgresql://plumbline_app:PASSWORD@localhost:5432/plumbline_dev"
DATABASE_URL_TEST="postgresql://plumbline_app:PASSWORD@localhost:5432/plumbline_test"

# Superuser/admin connection, used only for `prisma migrate` (DDL) and the
# GDPR deletion cascade (packages/model/src/deletion.ts — see that file for
# why deletion needs to be independent of RLS rather than a second
# application of it).
DATABASE_URL_MIGRATE="postgresql://postgres:PASSWORD@localhost:5432/plumbline_dev"
DATABASE_URL_MIGRATE_TEST="postgresql://postgres:PASSWORD@localhost:5432/plumbline_test"

# Narrow, SELECT-only-on-stores role for cross-tenant store-identity
# resolution (packages/model/src/identity.ts — webhooks and worker loops
# need to resolve a shop domain to an account BEFORE an RLS account context
# exists). Provision with `tsx scripts/provision-identity-role.ts`. Phase 8
# hardening: this used to reuse DATABASE_URL_MIGRATE (unrestricted DDL/DML)
# purely because no narrower role existed — see git history on identity.ts.
DATABASE_URL_IDENTITY="postgresql://plumbline_identity:PASSWORD@localhost:5432/plumbline_dev"
DATABASE_URL_IDENTITY_TEST="postgresql://plumbline_identity:PASSWORD@localhost:5432/plumbline_test"

# Shopify Partner app — create at https://partners.shopify.com
# Required before any live OAuth / API call will work.
# See packages/connector/src/errors.ts ShopifyCredentialsMissingError.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL="http://localhost:3000"
SHOPIFY_SCOPES="read_orders,read_all_orders,read_products,read_customers,read_discounts"
# API version to pin the connector to (never "unstable"/"latest" — see docs/PLAN.md §8)
SHOPIFY_API_VERSION="2026-01"

# Symmetric key for encrypting Store.accessTokenEncrypted/refreshTokenEncrypted
# (packages/connector's token-crypto.ts, AES-256-GCM). Rotate per docs/RUNBOOK.md.
TOKEN_ENCRYPTION_KEY=

# Base URL used to build report links in scheduled-report/alert emails
# (packages/report). Distinct from SHOPIFY_APP_URL (the OAuth callback
# host) even though they're the same value locally — this one has nothing
# to do with Shopify.
APP_BASE_URL="http://localhost:3000"
